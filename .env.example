# Yango Fleet SaaS — Variables d'environnement
# Copier ce fichier en .env.local et remplir avec les vraies valeurs

# ── Supabase (obligatoire) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Multi-tenancy ────────────────────────────────────────────────
# Slug utilisé sur localhost (développement)
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=m3a
# Domaine racine des sous-domaines tenant (une fois acquis dans Vercel).
# Ex "fleet.mondomaine.com" → les clients auront {slug}.fleet.mondomaine.com
# Laisser vide tant que le domaine n'est pas configuré (app en mono-domaine).
NEXT_PUBLIC_ROOT_DOMAIN=
# Emails de contact affichés (CGU, confidentialité, statut)
NEXT_PUBLIC_SUPPORT_EMAIL=gueye.a66@gmail.com
NEXT_PUBLIC_PRIVACY_EMAIL=gueye.a66@gmail.com

# ── Superadmin ──────────────────────────────────────────────────
# NE PAS mettre NEXT_PUBLIC_ — cette clé ne doit JAMAIS être exposée côté client
# Générer une clé aléatoire forte : openssl rand -base64 32
SUPERADMIN_KEY=your_strong_random_superadmin_key_here

# ── Couche IA V3 (optionnelle — l'app fonctionne à l'identique sans) ──
# Master-off d'urgence. L'autorité opérationnelle est en DB (fleet.ai_settings,
# pilotée via PATCH /api/ai/config par le superadmin, sans redéploiement).
AI_LAYER_ENABLED=on
# Clé LLM pour la narration (Anthropic prioritaire, sinon OpenAI). Aucune clé
# → mode dégradé : les chiffres calculés s'affichent sans narration.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modèle par défaut (surchargable par tenant via ai_config.llm_model_override)
AI_LLM_MODEL=
# Secret du cron Vercel (Authorization: Bearer) — openssl rand -hex 32
CRON_SECRET=
# Secret d'ingestion de l'analyse externe injectée dans le rapport d'activité
# (POST /api/integrations/report-analysis) — cf. docs/INTEGRATION-analyse-externe.md
REPORT_ANALYSIS_SECRET=

# ── Monitoring (Sentry) — https://sentry.io ─────────────────────
# DSN disponible dans Sentry → Settings → Projects → Keys
NEXT_PUBLIC_SENTRY_DSN=https://your_key@oXXXXXX.ingest.de.sentry.io/XXXXX
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
# Générer sur sentry.io/settings/account/api/auth-tokens/ (scope: project:write)
SENTRY_AUTH_TOKEN=sntryu_your_auth_token_here

# ── Extraction vision des déclarations (couche IA additive — spec Panthéon 04/08/2026) ──
# Modèles : ID daté OBLIGATOIRE pour le primaire (évite la dérive silencieuse
# si Anthropic met à jour le pointeur d'alias). Fallback si confiance < seuil.
ANTHROPIC_VISION_MODEL_PRIMARY=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL_FALLBACK=claude-sonnet-5
# Seuil de confiance moyenne déclenchant le fallback Haiku → Sonnet ([0,1])
ANTHROPIC_FALLBACK_CONFIDENCE_THRESHOLD=0.75
# Timeouts AbortController (ms)
ANTHROPIC_TIMEOUT_PRIMARY_MS=10000
ANTHROPIC_TIMEOUT_FALLBACK_MS=20000
# Limites upload extraction (après compression Canvas côté client)
AI_MAX_IMAGE_SIZE_BYTES=1048576
# Quota mensuel d'extractions par tenant (surchargable via ai_config.thresholds.monthly_quota)
AI_DEFAULT_MONTHLY_QUOTA=200
